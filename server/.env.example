# TyphoonLink Disaster Response Backend Configuration
# Copy this file to .env and configure for your environment.
# DO NOT commit real secrets or credentials to source control.

PROJECT_NAME="TyphoonLink Disaster Response Engine"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# SQLite Database Location (relative or absolute file URI)
DATABASE_URL="sqlite:///./database/typhoon_server.db"

# Security & Authentication (Required for Production/Staging)
# Generate a secure key with: openssl rand -hex 32
JWT_SECRET="typhoonlink-insecure-dev-secret-change-in-production-998124"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://127.0.0.1:5500,null"

# Rate Limiting (Demonstration-level in-memory guard)
RATE_LIMIT_SOS_PER_MINUTE=10
